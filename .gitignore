# ---- App runtime data (local, machine-specific) ----
# The launcher writes its DB, icon cache and logs to %LOCALAPPDATA%\Orbit,
# never inside the repo, but ignore any stray local copies just in case.
/data/
/logs/
/iconcache/
*.db
*.db-shm
*.db-wal
*.log

