<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light · Warm — ivory, terracotta accent. -->

    <Color x:Key="Color.Accent">#E27D3A</Color>
    <Color x:Key="Color.Accent.Hover">#EE9052</Color>
    <Color x:Key="Color.Accent.Pressed">#C96A2C</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FBF6EF" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#F5EEE2" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#F5EEE3" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#E7D8C4" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#D9C7AE" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#3B322A" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#8B7A66" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#26E27D3A" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#CF5045" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D98E2B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#5C9B67" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#59402E1C" />

</ResourceDictionary>
