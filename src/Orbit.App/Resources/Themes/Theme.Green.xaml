<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vert — green-tinted charcoal ground, green accent. -->
    <Color x:Key="Color.Accent">#3FB170</Color>
    <Color x:Key="Color.Accent.Hover">#54C284</Color>
    <Color x:Key="Color.Accent.Pressed">#329A5F</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#101812" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#0D140F" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#17231B" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1F2E24" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2C3D33" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#141F18" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#33453A" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E6F1E9" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#94AC9E" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#0B1F13" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#3D3FB170" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E5675E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E9A23B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#3FB170" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B00A140D" />
</ResourceDictionary>
