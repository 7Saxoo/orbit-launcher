<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Warm dark palette: cocoa charcoal (never pure black), amber accent. -->

    <Color x:Key="Color.Accent">#F0975A</Color>
    <Color x:Key="Color.Accent.Hover">#F5A971</Color>
    <Color x:Key="Color.Accent.Pressed">#D97F42</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#211C18" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#191512" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2C2521" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#372E28" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#423630" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#2C2521" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#4C3E35" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F4EADD" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B4A491" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#2A1B10" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#3D3025" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#E8675C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#EBB05C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7BB98A" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#A6140F0D" />

</ResourceDictionary>
