<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Accent">#4C8DFF</Color>
    <Color x:Key="Color.Accent.Hover">#5F9BFF</Color>
    <Color x:Key="Color.Accent.Pressed">#3D77E0</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#14161B" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#0E1014" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#252932" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2E333D" />

    <SolidColorBrush x:Key="Brush.Control.Background" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#3A404B" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F2F4F8" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#9BA3B2" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5A623" />
    <SolidColorBrush x:Key="Brush.Success" Color="#46A758" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#B3000000" />

</ResourceDictionary>
