<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Violet — violet-tinted charcoal ground, violet accent. -->
    <Color x:Key="Color.Accent">#8B5CF6</Color>
    <Color x:Key="Color.Accent.Hover">#9D75F8</Color>
    <Color x:Key="Color.Accent.Pressed">#7A46E0</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#16121F" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#1A1526" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#221C31" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#2C2540" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#392F52" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#1E1930" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#443A63" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDE9F8" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A79CC4" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#3D8B5CF6" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E5675E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E9A23B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#57B98A" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B00E0A18" />
</ResourceDictionary>
