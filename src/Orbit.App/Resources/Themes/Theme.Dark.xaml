<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sombre — near-black neutral ground, blue accent. -->
    <Color x:Key="Color.Accent">#3B82F6</Color>
    <Color x:Key="Color.Accent.Hover">#5A97F8</Color>
    <Color x:Key="Color.Accent.Pressed">#2F6BD4</Color>

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#141414" />
    <SolidColorBrush x:Key="Brush.NavRail.Background" Color="#0F0F0F" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1D1D1D" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#282828" />
    <SolidColorBrush x:Key="Brush.Surface.Border" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#ECECEC" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#333B82F6" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#E5675E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E9A23B" />
    <SolidColorBrush x:Key="Brush.Success" Color="#48B27E" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#B0000000" />
</ResourceDictionary>
