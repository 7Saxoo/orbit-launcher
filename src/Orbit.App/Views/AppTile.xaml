<UserControl x:Class="Orbit.App.Views.AppTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Orbit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AppTileViewModel}"
             d:DesignWidth="264">
    <Border Style="{StaticResource Card}" Width="264" Margin="0,0,16,16" Padding="0"
            ClipToBounds="True">
        <StackPanel>

            <!-- Banner -->
            <Grid Height="112">
                <Border Background="{DynamicResource Brush.Accent.Soft}" />
                <Image Width="56" Height="56" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Source="{Binding IconPath, Converter={StaticResource IconToImage}}"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <ToggleButton VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                              Cursor="Hand" Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsFavorite, Mode=OneWay}"
                              Command="{Binding ToggleFavoriteCommand}" ToolTip="Favori">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="☆" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                            <Setter Property="FontSize" Value="17" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#33000000" CornerRadius="7" Padding="5,2">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="★" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8"
                        Content="⋯" FontSize="17" Cursor="Hand"
                        Foreground="{DynamicResource Brush.Text.OnAccent}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Paramètres de l'application">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#33000000" CornerRadius="7" Padding="7,0,7,4">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#55000000" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                        Background="{DynamicResource Brush.Danger}" CornerRadius="5" Padding="6,2"
                        Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Introuvable" FontSize="11"
                               Foreground="{DynamicResource Brush.Text.OnAccent}" />
                </Border>
            </Grid>

            <!-- Body -->
            <StackPanel Margin="14,12,14,14">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SubtitleLabel}" Style="{StaticResource Text.Caption}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                <Button Margin="0,12,0,0" Style="{StaticResource Button.Accent}"
                        HorizontalAlignment="Stretch"
                        Content="{Binding PrimaryActionLabel}"
                        Command="{Binding LaunchCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
