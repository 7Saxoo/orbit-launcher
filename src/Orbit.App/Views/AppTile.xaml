<UserControl x:Class="Orbit.App.Views.AppTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Orbit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AppTileViewModel}"
             d:DesignWidth="260">
    <Border Style="{StaticResource Card}" Width="260" Margin="0,0,16,16">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                        Background="{DynamicResource Brush.Surface.Hover}">
                    <Image Width="36" Height="36"
                           Source="{Binding IconPath, Converter={StaticResource IconToImage}}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"
                               TextTrimming="CharacterEllipsis" MaxHeight="42" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                        <Run Text="{Binding KindLabel, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <ToggleButton Grid.Column="2" VerticalAlignment="Top"
                              Cursor="Hand" BorderThickness="0" Background="Transparent"
                              IsChecked="{Binding IsFavorite, Mode=OneWay}"
                              Command="{Binding ToggleFavoriteCommand}"
                              ToolTip="Ajouter/retirer des favoris">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Content" Value="☆" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="4">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="★" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding Availability, Converter={StaticResource AvailabilityToBrush}}" />
                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Caption}"
                           Text="{Binding Availability, Converter={StaticResource AvailabilityToText}}" />
            </StackPanel>

            <Button Margin="0,12,0,0" Style="{StaticResource Button.Accent}"
                    Content="▶  Lancer" HorizontalAlignment="Stretch"
                    Command="{Binding LaunchCommand}" />

            <Button Margin="0,8,0,0" Style="{StaticResource Button.Base}"
                    Content="Localiser le fichier…" HorizontalAlignment="Stretch"
                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding FixPathCommand}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                <Button Content="Modifier" Style="{StaticResource Button.Ghost}"
                        Command="{Binding EditCommand}" />
                <Button Content="Emplacement" Style="{StaticResource Button.Ghost}"
                        Command="{Binding RevealInExplorerCommand}" />
                <Button Content="Retirer" Style="{StaticResource Button.Danger}"
                        Command="{Binding RemoveCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
