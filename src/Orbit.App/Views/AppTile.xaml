<UserControl x:Class="Orbit.App.Views.AppTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Orbit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AppTileViewModel}"
             d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="TileIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileStarButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Content" Value="&#x2606;" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#x2605;" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" Margin="0,0,14,14" Padding="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform Y="0" />
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                        To="-3" Duration="0:0:0.11">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                        To="0" Duration="0:0:0.14">
                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel>

            <!-- Banner (top corners rounded to match the card) -->
            <Grid Height="128">
                <Border Background="{DynamicResource Brush.Accent.Soft}" CornerRadius="12,12,0,0" />
                <Image Width="76" Height="76" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Source="{Binding IconPath, Converter={StaticResource IconToImage}}"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <CheckBox VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8"
                          IsChecked="{Binding IsSelected}"
                          Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVisibility}}" />

                <ToggleButton VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6"
                              Style="{StaticResource TileStarButton}"
                              IsChecked="{Binding IsFavorite, Mode=OneWay}"
                              Command="{Binding ToggleFavoriteCommand}" ToolTip="Favori"
                              Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <Button VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                        Style="{StaticResource TileIconButton}" Content="⋯"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Paramètres de l'application"
                        Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                        Background="{DynamicResource Brush.Danger}" CornerRadius="5" Padding="6,2"
                        Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Introuvable" FontSize="11" Foreground="#FFFFFF" />
                </Border>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8"
                        Background="{DynamicResource Brush.Success}" CornerRadius="5" Padding="7,2"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="● En cours" FontSize="11" Foreground="#FFFFFF" />
                </Border>
            </Grid>

            <!-- Body -->
            <StackPanel Margin="14,12,14,14">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SubtitleLabel}" Style="{StaticResource Text.Caption}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                <Button Margin="0,12,0,0" Style="{StaticResource Button.Accent}"
                        HorizontalAlignment="Stretch"
                        Content="{Binding PrimaryActionLabel}"
                        Command="{Binding LaunchCommand}"
                        Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <Button Margin="0,12,0,0" Style="{StaticResource Button.Base}"
                        HorizontalAlignment="Stretch" Content="Cocher / décocher"
                        Command="{Binding ToggleSelectedCommand}"
                        Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
