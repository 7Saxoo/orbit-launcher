<Window x:Class="Orbit.App.Views.DetectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbit.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DetectionViewModel}"
        Title="Détection automatique" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">

    <DockPanel Margin="24" LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Détecter mes jeux et applications" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       Text="Orbit inspecte Steam, Epic Games et la liste des programmes installés de Windows. Rien n'est ajouté sans votre accord." />

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="🔍  Analyser mon PC" Style="{StaticResource Button.Accent}"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                <Button Content="Tout cocher" Style="{StaticResource Button.Ghost}" Margin="12,0,0,0"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="Tout décocher" Style="{StaticResource Button.Ghost}"
                        Command="{Binding SelectNoneCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                       Margin="0,12,0,8" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Fermer" Style="{StaticResource Button.Base}"
                        MinWidth="110" Margin="0,0,10,0" Click="OnClose" IsCancel="True" />
                <Button x:Name="ImportButton" Style="{StaticResource Button.Accent}" MinWidth="200"
                        Click="OnImport" IsEnabled="{Binding CanImport}"
                        Content="{Binding SelectedCount, StringFormat='Ajouter la sélection ({0})'}" />
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid>
            <Border Style="{StaticResource Card}" Padding="0">
                <ListBox ItemsSource="{Binding ItemsView}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="14,14,0,6" Style="{StaticResource Text.H2}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,7" Background="Transparent">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Center">
                                    <StackPanel Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                                    Background="{DynamicResource Brush.Accent.Soft}">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource Text.Caption}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,2,0,0" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Background="{DynamicResource Brush.Overlay}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Analyse du système en cours…" Foreground="White" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
