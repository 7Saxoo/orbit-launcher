<UserControl x:Class="Orbit.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Orbit.App.Views"
             xmlns:vm="clr-namespace:Orbit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             d:DesignWidth="900" d:DesignHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,28,20">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Accueil" Style="{StaticResource Text.H1}" />
                    <TextBlock Text="Vue d'ensemble de votre bibliothèque"
                               Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center"
                        Content="＋  Ajouter une application" Style="{StaticResource Button.Accent}"
                        Command="{Binding AddCommand}" />
            </Grid>

            <!-- Stat cards -->
            <UniformGrid Rows="1" Columns="5">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Total" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding GamesCount}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Jeux" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ApplicationsCount}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Applications" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{Binding FavoritesCount}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Favoris" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding MissingCount}" Style="{StaticResource Text.H1}"
                                   Foreground="{DynamicResource Brush.Danger}" />
                        <TextBlock Text="Introuvables" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Empty state -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="28"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Votre bibliothèque est vide"
                               Style="{StaticResource Text.H2}" HorizontalAlignment="Center" />
                    <TextBlock Text="Ajoutez un fichier .exe pour le retrouver et le lancer depuis Orbit."
                               Style="{StaticResource Text.Caption}" TextAlignment="Center"
                               Margin="0,8,0,16" />
                    <Button Content="＋  Ajouter ma première application"
                            Style="{StaticResource Button.Accent}" HorizontalAlignment="Center"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </Border>

            <!-- Recently added -->
            <TextBlock Text="Ajoutés récemment" Style="{StaticResource Text.H2}" Margin="0,22,0,10" />
            <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:AppTile />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Most launched -->
            <StackPanel Visibility="{Binding HasMostLaunched, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Les plus lancés" Style="{StaticResource Text.H2}" Margin="0,14,0,10" />
                <ItemsControl ItemsSource="{Binding MostLaunched}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AppTile />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
