<Window x:Class="Orbit.App.Views.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbit.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:AppSettingsViewModel}"
        Title="Paramètres de l'application" Height="680" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24" LastChildFill="True">

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface.Hover}">
                <Image Width="38" Height="38"
                       Source="{Binding IconPath, Converter={StaticResource IconToImage}}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H1}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding HeaderKind}" Style="{StaticResource Text.Caption}" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Fermer" Style="{StaticResource Button.Base}" MinWidth="96"
                    Margin="0,0,10,0" Command="{Binding CloseCommand}" IsCancel="True" />
            <Button Content="Enregistrer" Style="{StaticResource Button.Base}" MinWidth="120"
                    Margin="0,0,10,0" Command="{Binding SaveCommand}" />
            <Button Content="▶  Lancer" Style="{StaticResource Button.Accent}" MinWidth="130"
                    Command="{Binding LaunchCommand}" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Général -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Général" Style="{StaticResource Text.H2}" />

                        <TextBlock Text="Nom" Style="{StaticResource Lbl}" />
                        <TextBox Style="{StaticResource TextBox.Base}"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                        <TextBlock Text="Type" Style="{StaticResource Lbl}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Kind" Content="Application" Margin="0,0,18,0"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Application}" />
                            <RadioButton GroupName="Kind" Content="Jeu"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Game}" />
                        </StackPanel>

                        <TextBlock Text="Catégorie" Style="{StaticResource Lbl}" />
                        <ComboBox Style="{StaticResource ComboBox.Base}" IsEditable="True"
                                  ItemsSource="{Binding CategorySuggestions}"
                                  Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Description" Style="{StaticResource Lbl}" />
                        <TextBox Style="{StaticResource TextBox.Base}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="56" VerticalContentAlignment="Top"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- Lancement -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Lancement" Style="{StaticResource Text.H2}" />

                        <TextBlock Text="Fichier exécutable (.exe)" Style="{StaticResource Lbl}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource TextBox.Base}"
                                     Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <Button Grid.Column="1" Content="Parcourir…" Style="{StaticResource Button.Base}"
                                    Margin="8,0,0,0" Command="{Binding BrowseExecutableCommand}" />
                        </Grid>

                        <TextBlock Text="Dossier de travail (optionnel)" Style="{StaticResource Lbl}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource TextBox.Base}"
                                     Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="Parcourir…" Style="{StaticResource Button.Base}"
                                    Margin="8,0,0,0" Command="{Binding BrowseWorkingDirectoryCommand}" />
                        </Grid>

                        <TextBlock Text="Arguments de ligne de commande (optionnel)" Style="{StaticResource Lbl}" />
                        <TextBox Style="{StaticResource TextBox.Base}"
                                 Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Mémoire max Java — Mo (Minecraft &amp; jeux Java, optionnel)"
                                   Style="{StaticResource Lbl}" />
                        <TextBox Style="{StaticResource TextBox.Base}" MaxWidth="160" HorizontalAlignment="Left"
                                 Text="{Binding JavaMemoryText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                   Text="Ajoute -Xmx / -Xms aux arguments." />

                        <CheckBox Margin="0,14,0,0" Content="Lancer en tant qu'administrateur"
                                  IsChecked="{Binding RunAsAdmin}" />
                    </StackPanel>
                </Border>

                <!-- Emplacement -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Emplacement" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding LocationPath}" Style="{StaticResource Text.Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Button Content="Ouvrir dans l'explorateur" Style="{StaticResource Button.Base}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding OpenLocationCommand}" />
                    </StackPanel>
                </Border>

                <!-- Zone de danger -->
                <Border Style="{StaticResource Card}"
                        BorderBrush="{DynamicResource Brush.Danger}">
                    <StackPanel>
                        <TextBlock Text="Zone de danger" Style="{StaticResource Text.H2}"
                                   Foreground="{DynamicResource Brush.Danger}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,10"
                                   Text="Retire l'entrée d'Orbit. Le fichier .exe d'origine reste sur le disque." />
                        <Button Content="Supprimer de la bibliothèque" Style="{StaticResource Button.Danger}"
                                HorizontalAlignment="Left" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
