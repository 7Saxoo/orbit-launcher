<UserControl x:Class="Orbit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Orbit.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignWidth="900" d:DesignHeight="620">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,6,28,20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource Text.H1}" Margin="0,0,0,18" />

            <!-- Apparence -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Apparence" Style="{StaticResource Text.H2}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Thème" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Clair, sombre ou selon Windows" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" Style="{StaticResource ComboBox.Base}"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Label" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bibliothèque -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Bibliothèque" Style="{StaticResource Text.H2}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Tri par défaut" Style="{StaticResource Text.Body}" />
                            <TextBlock Text="Ordre appliqué à l'ouverture de la bibliothèque"
                                       Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180" Style="{StaticResource ComboBox.Base}"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort}"
                                  DisplayMemberPath="Label" />
                    </Grid>

                    <CheckBox Margin="0,14,0,0" Foreground="{DynamicResource Brush.Text.Primary}"
                              IsChecked="{Binding ConfirmBeforeRemove}"
                              Content="Demander confirmation avant de retirer une application" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="{Binding EntryCount, StringFormat='{}{0} application(s) enregistrée(s)'}"
                                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Données -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Données" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               Text="{Binding DataFolderPath, StringFormat='Emplacement : {0}'}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Ouvrir le dossier de données" Style="{StaticResource Button.Base}"
                                Margin="0,0,10,0" Command="{Binding OpenDataFolderCommand}" />
                        <Button Content="Réinitialiser les données…" Style="{StaticResource Button.Danger}"
                                Command="{Binding ResetDataCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Text="La réinitialisation supprime les entrées et le cache d'icônes. Les fichiers .exe d'origine ne sont jamais supprimés." />
                </StackPanel>
            </Border>

            <!-- À propos -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="À propos" Style="{StaticResource Text.H2}" />
                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    <TextBlock Text="Launcher local pour centraliser applications et jeux Windows."
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
