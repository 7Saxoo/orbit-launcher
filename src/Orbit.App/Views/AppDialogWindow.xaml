<Window x:Class="Orbit.App.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        FontFamily="{StaticResource Font.Primary}"
        Title="Orbit">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                    Background="{DynamicResource Brush.Accent.Soft}">
                <TextBlock x:Name="Glyph" Text="?" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
            </Border>
            <TextBlock x:Name="TitleText" Margin="14,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Text.H2}" TextWrapping="Wrap" MaxWidth="330" />
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,16,0,0"
                   Style="{StaticResource Text.Body}" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SecondaryButton" MinWidth="96" Margin="0,0,10,0"
                    Style="{StaticResource Button.Base}" Click="OnSecondary" IsCancel="True" />
            <Button x:Name="PrimaryButton" MinWidth="110"
                    Style="{StaticResource Button.Accent}" Click="OnPrimary" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
