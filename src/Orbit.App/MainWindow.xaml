<Window x:Class="Orbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbit.App.ViewModels"
        xmlns:inf="clr-namespace:Orbit.App.Infrastructure"
        mc:Ignorable="d"
        Title="Orbit — Centralisateur d'applications et de jeux"
        Height="780" Width="1280" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        TextOptions.TextFormattingMode="Ideal"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Navigation rail ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.NavRail.Background}"
                BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Image Source="pack://application:,,,/Orbit;component/Assets/orbit-mark.png"
                           Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="ORBIT" FontSize="16" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="6,8,6,10">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Settings}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                            <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Margin="6,2,6,8">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Home}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;" />
                            <TextBlock Text="Accueil" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Library}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Library}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavGlyph}" Text="&#xE8F1;" />
                            <TextBlock Grid.Column="1" Text="Bibliothèque" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NavCount}"
                                       Text="{Binding Home.TotalCount}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Games}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Games}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavGlyph}" Text="&#xE7FC;" />
                            <TextBlock Grid.Column="1" Text="Jeux" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NavCount}"
                                       Text="{Binding Home.GamesCount}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Applications}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Applications}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavGlyph}" Text="&#xE71D;" />
                            <TextBlock Grid.Column="1" Text="Applications" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NavCount}"
                                       Text="{Binding Home.ApplicationsCount}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Favorites}"
                                 IsChecked="{Binding CurrentSection, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Favorites}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavGlyph}" Text="&#xE734;" />
                            <TextBlock Grid.Column="1" Text="Favoris" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NavCount}"
                                       Text="{Binding Home.FavoritesCount}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Content ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="28,20,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left"
                          Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Base}" Padding="30,8,10,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                   IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="Rechercher…" IsHitTestVisible="False"
                                   Margin="30,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringToVisibility}, ConverterParameter=invert}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" Margin="0,0,10,0"
                                Command="{Binding Library.ReloadCommand}" ToolTip="Actualiser">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Actualiser" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding Library.AddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Border DockPanel.Dock="Bottom" Padding="28,9"
                    Background="{DynamicResource Brush.NavRail.Background}"
                    BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                               Text="Orbit v1.6.0 · developed by Saxo" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                               Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Success}"
                               Text="● Détection automatique disponible" />
                </Grid>
            </Border>

            <inf:FadeContentControl Content="{Binding CurrentContent}" ClipToBounds="True" />
        </DockPanel>
    </Grid>
</Window>
