<Window x:Class="Orbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Orbit.App.ViewModels"
        xmlns:views="clr-namespace:Orbit.App.Views"
        mc:Ignorable="d"
        Title="Orbit — Centralisateur d'applications et de jeux"
        Height="780" Width="1280" MinHeight="560" MinWidth="900"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.Window.Background}"
        TextOptions.TextFormattingMode="Ideal"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== Navigation rail ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.NavRail.Background}"
                BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,18,18,14">
                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <Ellipse Width="29" Height="13" StrokeThickness="3"
                                 Stroke="{DynamicResource Brush.Text.Secondary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-24" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="19" Height="19" Fill="{DynamicResource Brush.Accent}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Text.OnAccent}"
                                 Opacity="0.75" Margin="0,4,7,0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="ORBIT" FontSize="16" FontWeight="Bold" Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,8,8,10">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Settings}"
                                 IsChecked="{Binding IsSettings, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                            <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Margin="8,2,8,8">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Home}"
                                 IsChecked="{Binding IsHome, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;" />
                            <TextBlock Text="Accueil" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="{x:Static vm:NavigationSection.Library}"
                                 IsChecked="{Binding IsLibrary, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource NavGlyph}" Text="&#xE8F1;" />
                            <TextBlock Grid.Column="1" Text="Bibliothèque" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Style="{StaticResource NavCount}"
                                       Text="{Binding Home.TotalCount}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== Content ==================== -->
        <DockPanel Grid.Column="1" LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="26,16,26,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search (Bibliothèque only) -->
                    <Grid Grid.Column="0" Width="360" HorizontalAlignment="Left"
                          Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVisibility}}">
                        <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Base}"
                                 Padding="32,7,10,7"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                   IsHitTestVisible="False" Margin="11,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock IsHitTestVisible="False" Text="Rechercher…"
                                   Margin="32,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringToVisibility}}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" Margin="0,0,10,0"
                                Command="{Binding Library.ReloadCommand}" ToolTip="Actualiser">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Actualiser" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Accent}" Command="{Binding Library.AddCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Ajouter" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Border DockPanel.Dock="Bottom" Padding="26,8"
                    Background="{DynamicResource Brush.NavRail.Background}"
                    BorderBrush="{DynamicResource Brush.Surface.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                               Text="Orbit v2.0.0 · developed by Saxo" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                               Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Success}"
                               Text="● Détection automatique" />
                </Grid>
            </Border>

            <!-- All three views stay alive; navigation only toggles visibility. -->
            <Grid>
                <views:HomeView DataContext="{Binding Home}"
                                Visibility="{Binding DataContext.IsHome, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:LibraryView DataContext="{Binding Library}"
                                   Visibility="{Binding DataContext.IsLibrary, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>
